create view clientes_oriundo as
select c.id, c.nombre, ci.nombre as ciudad
from clientes c
join ciudades ci on c.ciudad_id = ci.id;

select *
from clientes_oriundo
where ciudad = 'santa fe';

create view ciudades_provincia as
select ci.id, ci.nombre as ciudad, p.nombre as provincia
from ciudades ci
join provincias p on ci.provincia_id = p.id;

create view provincias_varias_ciudades as
select p.nombre as provincia, count(ci.id) as cantidad_ciudades
from provincias p
join ciudades ci on p.id = ci.provincia_id
group by p.nombre
having count(ci.id) > 1;

create view productos_sin_stock as
select *
from productos
where stock = 0;

select *
from productos_sin_stock
where precio = (select max(precio) from productos_sin_stock)
   or precio = (select min(precio) from productos_sin_stock);

create view clientes_compra as
select distinct c.id, c.nombre
from clientes c
join compras co on c.id = co.cliente_id;

select c.id, c.nombre, sum(dc.cantidad) as total_productos
from clientes c
join compras co on c.id = co.cliente_id
join detalle_compra dc on co.id = dc.compra_id
group by c.id, c.nombre;

select c.id, c.nombre, sum(dc.cantidad * dc.precio) as total_gastado
from clientes c
join compras co on c.id = co.cliente_id
join detalle_compra dc on co.id = dc.compra_id
group by c.id, c.nombre;

create view productos_no_comprados as
select p.*
from productos p
left join detalle_compra dc on p.id = dc.producto_id
where dc.producto_id is null;
