CREATE FUNCTION nombre_completo(nombre varchar(50), apellido varchar(50))
RETURNS varchar(100)
DETERMINISTIC BEGIN 
RETURN concat nombre_completo(nombre, "," , apellido);
END;

4)
CREATE FUNCTION estado_stock(stock int)
returns varchar(20)
DETERMINISTIC BEGIN
if stock=0 THEN RETURN "sin stock";
ELSEIF stock<20 THEN RETURN "bajo stock";
ELSE RETURN "disponible";
end IF;
END;

5)
CREATE FUNCTION clasificar_precio(precio decimal(10,2))
returns varchar(20)
DETERMINISTIC BEGIN
if precio<100 THEN RETURN "barato";
ELSEIF precio<=500 THEN RETURN "medio";
ELSE precio>500 then RETURN "caro";
end IF;
END;

