CREATE FUNCTION obtener_precio(id_producto INT)
RETURNS decimal(10,2)
READS SQL DATA
BEGIN
   DECLARE p DECIMAL(10,2);

   SELECT precio
   INTO p
   FROM productos
   WHERE productos.id_producto = id_producto;

   RETURN p;
END;

8)
create function obtener_stock(id_producto int)
RETURNS INT
READS SQL DATA
BEGIN
   DECLARE s INT;
   select stock into s from productos WHERE productos.id_producto=id_producto;
   RETURN s;
END;

