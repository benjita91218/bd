end;

create function alerta_stock(id_producto int)
returns varchar(30)
begin
declare stock actual int;
select stock into stock_actual from productos where id = id_producto;
if stock_actual=0 then return "REPOSICION URGENTE";
elseif stock_actual<20 then return "STOCK BAJO";
else return "OK";
end if;
end;

