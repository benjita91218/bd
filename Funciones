create function producto_mas_vendido()
returns varchar(100)
begin 
declare nombre_producto varchar(100);
select p.nombre into nombre_producto from productos p join compras c on p.id = c.id_producto group by p.id, p.nombre order by
sum(c.cantidad) desc limit 1;
return nombre_producto;
end;

create function producto_menos_vendido()
returns varchar(100)
begin 
declare nombre_producto varchar(100);
select p.nombre into nombre_producto from productos p join compras c on p.id = c.id_producto GROUP BY p.id, p.nombre order by 
sum(c.cantidad) asc
limit 1;
return nombre_producto;
end;

create function promedio_precios()
returns decimal(10,2)
begin
declare promedio decimal(10,2);
select abg(precio) into promedio from productos;
return promedio;
end;

create function comparar_promedio(id_producto int)
returns varchar(30)
begin
declare precio_producto decimal(10,2);
