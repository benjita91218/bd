end//
delimiter;

delimiter//
create procedure eliminar_clientes_sinComprasDesde(in p_fecha date)
begin
delete from clientes where id_cliente not in(select id_cliente from compras where fecha_compra >= p_fecha);
end//
delimiter;

delimiter//
create procedure marcar_fuera_stock(in p_id_producto int)
begin
update productos set fuera_stock = true where id_producto=p_id_producto;
end//
delimiter;

