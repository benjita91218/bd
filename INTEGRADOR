CREATE TRIGGER estado_devolucion
AFTER UPDATE on prestamos
for each ROW
BEGIN

IF OLD.FechaDevolucionReal IS NULL AND NEW.FechaDevolucionReal IS NOT NULL THEN
UPDATE ejemplares set estado = "disponible" WHERE EjemplarID=new.EjemplarID;
END IF;

END //
