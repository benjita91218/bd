/* =========================================================
   CREACIÓN DE ROLES Y USUARIOS
   ========================================================= */

-- Roles de trabajo.
CREATE ROLE IF NOT EXISTS
    'rol_zonas'@'localhost',
    'rol_stock'@'localhost',
    'rol_gerente'@'localhost';

-- 1. Administrador de zonas: consultar provincias, ciudades y vista pública.
GRANT SELECT ON tienda.provincias TO 'rol_zonas'@'localhost';
GRANT SELECT ON tienda.ciudades TO 'rol_zonas'@'localhost';
GRANT SELECT ON biblioteca.vw_usuarios_publicos TO 'rol_zonas'@'localhost';

-- 2. Operador de productos: consultar, agregar y modificar stock/precio.
GRANT SELECT ON tienda.productos TO 'rol_stock'@'localhost';
GRANT INSERT ON tienda.productos TO 'rol_stock'@'localhost';
GRANT UPDATE (stock, precio) ON tienda.productos TO 'rol_stock'@'localhost';
GRANT DELETE ON tienda.productos TO 'rol_stock'@'localhost';
-- Aunque tiene permiso DELETE, el trigger solo permite borrar si stock = 0.

-- 3. Gerente: administrar usuarios/clientes y compras.
GRANT SELECT, INSERT, UPDATE, DELETE
ON tienda.clientes TO 'rol_gerente'@'localhost';

GRANT SELECT, INSERT, UPDATE, DELETE
ON tienda.compras TO 'rol_gerente'@'localhost';

GRANT SELECT, INSERT, UPDATE, DELETE
ON tienda.detalle_compra TO 'rol_gerente'@'localhost';

GRANT SELECT, INSERT, UPDATE, DELETE
ON biblioteca.Usuarios TO 'rol_gerente'@'localhost';

-- Crear cuentas de ejemplo. Cambiar las contraseñas al usarlo realmente.
CREATE USER IF NOT EXISTS 'admin_zonas'@'localhost'
    IDENTIFIED BY 'Cambiar_Clave_Zonas_123!';
CREATE USER IF NOT EXISTS 'operador_stock'@'localhost'
    IDENTIFIED BY 'Cambiar_Clave_Stock_123!';
CREATE USER IF NOT EXISTS 'gerente'@'localhost'
    IDENTIFIED BY 'Cambiar_Clave_Gerente_123!';

GRANT 'rol_zonas'@'localhost' TO 'admin_zonas'@'localhost';
GRANT 'rol_stock'@'localhost' TO 'operador_stock'@'localhost';
GRANT 'rol_gerente'@'localhost' TO 'gerente'@'localhost';

SET DEFAULT ROLE 'rol_zonas'@'localhost'
    TO 'admin_zonas'@'localhost';
SET DEFAULT ROLE 'rol_stock'@'localhost'
    TO 'operador_stock'@'localhost';
SET DEFAULT ROLE 'rol_gerente'@'localhost'
    TO 'gerente'@'localhost';

/* =========================================================
   4. USUARIO 2: REVOCAR EL PERMISO DE ELIMINAR
   ========================================================= */

CREATE USER IF NOT EXISTS 'usuario2'@'localhost'
    IDENTIFIED BY 'Cambiar_Clave_Usuario2_123!';

-- Primero se simula que el usuario tenía permisos completos sobre tienda.
GRANT SELECT, INSERT, UPDATE, DELETE
ON tienda.* TO 'usuario2'@'localhost';

-- Ahora se le quita DELETE: conserva los demás permisos, pero no puede borrar.
REVOKE DELETE ON tienda.* FROM 'usuario2'@'localhost';


