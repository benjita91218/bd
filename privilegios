/* =========================================================
   TRIGGER PARA IMPEDIR BORRAR PRODUCTOS CON STOCK
   ========================================================= */
USE tienda;

DELIMITER $$
CREATE TRIGGER trg_no_borrar_producto_con_stock
BEFORE DELETE ON productos
FOR EACH ROW
BEGIN
    IF OLD.stock > 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'No se puede eliminar un producto que tiene stock';
    END IF;
END$$
DELIMITER ;


/* =========================================================
   TABLA Y TRIGGERS DE AUDITORÍA
   ========================================================= */
CREATE TABLE IF NOT EXISTS AuditoriaCambios (
    AuditoriaID INT AUTO_INCREMENT PRIMARY KEY,
    UsuarioBD VARCHAR(150),
    TablaAfectada VARCHAR(80),
    Accion VARCHAR(20),
    ClaveRegistro VARCHAR(100),
    DatosAnteriores JSON,
    DatosNuevos JSON,
    Fecha DATETIME DEFAULT CURRENT_TIMESTAMP
);

DELIMITER $$

-- Auditoría de inserciones en productos.
CREATE TRIGGER trg_auditoria_productos_insert
AFTER INSERT ON productos
FOR EACH ROW
BEGIN
    INSERT INTO AuditoriaCambios
        (UsuarioBD, TablaAfectada, Accion, ClaveRegistro, DatosNuevos)
    VALUES
        (USER(), 'productos', 'INSERT', NEW.id_producto,
         JSON_OBJECT('nombre', NEW.nombre_producto, 'precio', NEW.precio,
                     'stock', NEW.stock));
END$$


-- Auditoría de modificaciones en productos.
CREATE TRIGGER trg_auditoria_productos_update
AFTER UPDATE ON productos
FOR EACH ROW
BEGIN
    INSERT INTO AuditoriaCambios
        (UsuarioBD, TablaAfectada, Accion, ClaveRegistro,
         DatosAnteriores, DatosNuevos)
    VALUES
        (USER(), 'productos', 'UPDATE', NEW.id_producto,
         JSON_OBJECT('nombre', OLD.nombre_producto, 'precio', OLD.precio,
                     'stock', OLD.stock),
         JSON_OBJECT('nombre', NEW.nombre_producto, 'precio', NEW.precio,
                     'stock', NEW.stock));
END$$

-- Auditoría de eliminaciones en productos.
CREATE TRIGGER trg_auditoria_productos_delete
AFTER DELETE ON productos
FOR EACH ROW
BEGIN
    INSERT INTO AuditoriaCambios
        (UsuarioBD, TablaAfectada, Accion, ClaveRegistro, DatosAnteriores)
    VALUES
        (USER(), 'productos', 'DELETE', OLD.id_producto,
         JSON_OBJECT('nombre', OLD.nombre_producto, 'precio', OLD.precio,
                     'stock', OLD.stock));
END$$

